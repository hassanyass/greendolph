# Leave blank until a domain is confirmed. Use an HTTPS origin without a path.
SITE_URL=
# preview or production; development and review deployments should stay preview.
SITE_ENV=preview
# Enable only when the finished content and company information are launch-ready.
SITE_INDEXABLE=false

# Adobe Fonts web-project ID for Acumin Variable, when supplied.
PUBLIC_ADOBE_FONTS_KIT_ID=

# Public form ID from Formspree Integration. Leave blank for local quotation previews.
FORMSPREE_FORM_ID=
# Override the temporary company-phone WhatsApp number, including + and country code.
CONTACT_WHATSAPP=
# Public contact email and full HTTPS social profile URLs, when confirmed.
CONTACT_EMAIL=
CONTACT_INSTAGRAM=
CONTACT_FACEBOOK=
CONTACT_TIKTOK=
