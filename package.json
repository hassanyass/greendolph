{
  "name": "greendolph",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build && node scripts/finalize-build.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "test": "node --experimental-transform-types --test tests/*.test.ts",
    "verify:build": "node scripts/verify-build.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm test && npm run check && npm run build && npm run verify:build"
  },
  "dependencies": {
    "astro": "7.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "22.20.5",
    "node": "22.23.4",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.23.4",
    "npm": ">=10"
  }
}
