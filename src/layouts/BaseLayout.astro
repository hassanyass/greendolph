---
import ContactLinks from '../components/ContactLinks.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SeoHead from '../components/SeoHead.astro';
import { brand } from '../config/brand';
import { copy } from '../config/content';
import { site } from '../config/site';
import { routes, type Locale, type PageDefinition } from '../domain/routes';
import type { Service } from '../domain/service';
import { PageMetadata } from '../domain/seo';
import '../styles/global.css';

interface Props {
  locale: Locale;
  page?: PageDefinition;
  title?: string;
  service?: Service;
  description?: string;
  shareImage?: { src: string; width: number; height: number; alt: string };
}
const {
  locale,
  service,
  page = routes.page('home'),
  title = copy[locale].title,
  description = copy[locale].description,
  shareImage = { ...brand.shareImages[locale], alt: title },
} = Astro.props;
const metadata = new PageMetadata(
  site,
  page,
  locale,
  title,
  description,
  shareImage.src,
  page.indexable,
);
---

<!doctype html>
<html
  lang={locale}
  dir={locale === 'ar' ? 'rtl' : 'ltr'}
  style={brand.cssVariables()}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoHead metadata={metadata} service={service} shareImage={shareImage} />
    <meta name="theme-color" content={brand.colors.forest} />
    <link rel="icon" type={brand.favicon.type} href={brand.favicon.src} />
    {(locale === 'ar' || !brand.typography.stylesheet) && (
      <link
        rel="preload"
        href={brand.typography[locale].preload}
        as="font"
        type="font/woff2"
        crossorigin="anonymous"
      />
    )}
    {brand.typography.stylesheet && (
      <link href={brand.typography.stylesheet} rel="stylesheet" />
    )}
  </head>
  <body>
    <a href="#main" class="skip-link">
      {copy[locale].skip}
    </a>
    <Header locale={locale} page={page.key} />
    <main id="main" class:list={{ landing: page.key === 'home' }}>
      <slot />
    </main>
    <Footer locale={locale} page={page.key} />
    <ContactLinks locale={locale} placement="shortcut" />
    <script src="../scripts/interactions.ts"></script>
  </body>
</html>
