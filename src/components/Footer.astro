---
import '../styles/footer.css';
import ContactLinks from './ContactLinks.astro';
import BrandLogo from './BrandLogo.astro';
import { copy, type Locale } from '../config/content';
import {
  routes,
  navigation,
  navigationHref,
  type PageKey,
} from '../domain/routes';
const { locale, page = 'home' } = Astro.props as {
  locale: Locale;
  page?: PageKey;
};
const t = copy[locale];
---

<footer>
  <div class="footer-main">
    <div class="footer-brand">
      <BrandLogo locale={locale} variant="inverse" loading="lazy" />
      <p>{t.footerText}</p>
      <span>{t.footerLocation}</span>
    </div>
    <nav class="footer-links" aria-label={t.footerNav}>
      <p class="eyebrow">{t.footerNav}</p>
      {navigation.map((item) => (
        <a href={navigationHref(item, locale)}>{t.nav[item.labelIndex]}</a>
      ))}
    </nav>
    <div class="footer-cta">
      <p class="eyebrow">{t.footerContact}</p>
      <a href={routes.enquiry(locale)}>{t.quote}</a>
      <ContactLinks locale={locale} placement="footer" />
    </div>
  </div>
  <div class="footer-bottom">
    <p class="footer-legal">
      <span>
        © {new Date().getFullYear()} {t.copyright}
      </span>
      <span>{t.rights}</span>
    </p>
    <a
      class="footer-language"
      href={routes.alternate(page === 'notFound' ? 'home' : page, locale)}
      lang={locale === 'en' ? 'ar' : 'en'}
    >
      {t.lang}
    </a>
  </div>
</footer>
