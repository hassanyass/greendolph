---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuoteForm from './QuoteForm.astro';
import type { Locale } from '../domain/routes';
import { routes } from '../domain/routes';
const { locale } = Astro.props as { locale: Locale };
---

<BaseLayout locale={locale} page={routes.page('contact')}>
  <QuoteForm locale={locale} standalone />
</BaseLayout>
