---
import { featuredProjectIds, projects } from '../config/projects';
import { homeWorksCopy } from '../config/home-works';
import { services } from '../config/services';
import { routes, type Locale } from '../domain/routes';
import ControlIcon from './ControlIcon.astro';
import ProjectImage from './ProjectImage.astro';

const { locale } = Astro.props as { locale: Locale };
const t = (key: keyof typeof homeWorksCopy) => homeWorksCopy[key][locale];
const featured = featuredProjectIds.map((id) => {
  const project = projects.find((item) => item.id === id);
  if (!project || project.illustrativePhotos || !project.photos.length) {
    throw new Error(
      `Homepage project ${id} must have real project photographs.`,
    );
  }
  return project;
});
const photoSizes = (index: number) =>
  index === 0
    ? '(min-width: 1600px) 780px, (min-width: 1100px) 49vw, (min-width: 700px) 89vw, 90vw'
    : '(min-width: 1600px) 250px, (min-width: 1100px) 17vw, (min-width: 700px) 43vw, 90vw';
---

<section class="selected-works" aria-labelledby="selected-works-title">
  <div class="section selected-works-inner">
    <div class="selected-works-heading">
      <div>
        <p class="eyebrow">{t('label')}</p>
        <h2 id="selected-works-title">{t('title')}</h2>
        <p class="selected-works-intro">{t('intro')}</p>
      </div>
      <a class="text-link" href={routes.path('works', locale)}>
        {t('viewAll')}
        <ControlIcon name="next" />
      </a>
    </div>
    <div class="selected-works-grid">
      {featured.map((project, index) => (
        <article
          class:list={[
            'selected-project',
            { 'selected-project-feature': index === 0 },
          ]}
        >
          <a
            class="selected-project-link"
            href={routes.project(project.id).paths[locale]}
          >
            <div class="selected-project-photo" data-project-preview>
              <template>
                <ProjectImage
                  photo={project.homepagePhoto ?? project.photos[0]}
                  locale={locale}
                  sizes={photoSizes(index)}
                />
              </template>
              <noscript>
                <ProjectImage
                  photo={project.homepagePhoto ?? project.photos[0]}
                  locale={locale}
                  sizes={photoSizes(index)}
                />
              </noscript>
            </div>
            <div class="selected-project-body">
              <p class="selected-project-location">
                {project.location[locale]}
              </p>
              <h3>{project.title[locale]}</h3>
              <p class="selected-project-summary">
                {(project.teaser ?? project.summary)[locale]}
              </p>
              <ul
                class="selected-project-trades"
                aria-label={t('relatedServices')}
              >
                {project.serviceIds.slice(0, 2).map((id) => (
                  <li>
                    {
                      services.find((service) => service.id === id)?.title[
                        locale
                      ]
                    }
                  </li>
                ))}
              </ul>
              <span class="selected-project-action">
                {t('viewProject')}
                <ControlIcon name="next" />
              </span>
            </div>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>

<script src="../scripts/project-previews.ts"></script>

<style>
  .selected-works {
    background: var(--mist);
    border-block: 1px solid var(--line);
  }
  .selected-works-inner {
    padding-block: var(--section-space);
  }
  .selected-works-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: var(--panel-gap);
    margin-block-end: 32px;
  }
  .selected-works-heading h2 {
    margin-block-start: 8px;
  }
  .selected-works-intro {
    margin-block-start: 16px;
    max-inline-size: 48ch;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.7;
  }
  .selected-works-heading > a {
    flex-shrink: 0;
    color: var(--green);
  }
  .selected-works-grid {
    display: grid;
    gap: var(--panel-gap);
  }
  .selected-project {
    min-inline-size: 0;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--panel-radius);
  }
  .selected-project-link {
    display: flex;
    flex-direction: column;
    block-size: 100%;
    border-radius: inherit;
  }
  .selected-project-photo {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-start-start-radius: inherit;
    border-start-end-radius: inherit;
  }
  .selected-project-photo :global(img) {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    transition: transform 350ms ease;
  }
  .selected-project-body {
    display: flex;
    flex-direction: column;
    align-items: start;
    padding: 24px;
    flex: 1;
  }
  .selected-project-location {
    color: var(--green);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.6;
  }
  .selected-project h3 {
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 1.65vw, 1.5rem);
    line-height: 1.25;
    font-weight: 500;
    letter-spacing: -0.02em;
    margin-block-start: 8px;
    text-wrap: balance;
  }
  .selected-project-summary {
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.7;
    margin-block-start: 12px;
  }
  .selected-project-trades {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    padding: 0;
    margin-block: 16px 20px;
    list-style: none;
    color: var(--green);
    font-size: 0.75rem;
    line-height: 1.65;
  }
  .selected-project-action {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    inline-size: 100%;
    margin-block-start: auto;
    padding-block-start: 14px;
    border-block-start: 1px solid var(--line);
    color: var(--green);
    font-size: 0.875rem;
    font-weight: 600;
    min-block-size: 44px;
  }
  .selected-project-link:focus-visible {
    outline-offset: 5px;
  }
  :global([dir='rtl']) .selected-works-heading :global(.control-icon),
  :global([dir='rtl']) .selected-project-action :global(.control-icon) {
    transform: scaleX(-1);
  }
  :global([dir='rtl']) .selected-project h3 {
    letter-spacing: normal;
    line-height: 1.6;
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .selected-project-link:hover :global(img) {
      transform: scale(1.035);
    }
  }
  @media (min-width: 700px) {
    .selected-works-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .selected-project-feature {
      grid-column: 1 / -1;
    }
    .selected-project-feature .selected-project-photo {
      aspect-ratio: 1.8;
    }
  }
  @media (min-width: 1100px) {
    .selected-works-grid {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      grid-template-rows: repeat(2, minmax(0, 1fr));
    }
    .selected-project-feature {
      grid-column: auto;
      grid-row: span 2;
    }
    .selected-project-feature .selected-project-photo {
      aspect-ratio: auto;
      flex: 1;
      min-block-size: 320px;
    }
    .selected-project-feature .selected-project-body {
      flex: 0 0 auto;
    }
    .selected-project-feature h3 {
      font-size: clamp(1.625rem, 2.1vw, 2rem);
    }
    .selected-project:not(.selected-project-feature) .selected-project-link {
      display: grid;
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    }
    .selected-project:not(.selected-project-feature) .selected-project-photo {
      aspect-ratio: auto;
      border-start-end-radius: 0;
      border-end-start-radius: var(--panel-radius);
    }
    .selected-project:not(.selected-project-feature) .selected-project-body {
      padding: clamp(20px, 1.8vw, 28px);
    }
  }
  @media (max-width: 699px) {
    .selected-works-heading {
      flex-direction: column;
      align-items: start;
      gap: 12px;
      margin-block-end: 24px;
    }
    .selected-project-body {
      padding: 20px;
    }
  }
</style>
