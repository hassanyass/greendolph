---
import BaseLayout from '../layouts/BaseLayout.astro';
import { routes } from '../domain/routes';
import { copy, type Locale } from '../config/content';
import { legacyServiceIds, services } from '../config/services';
import { servicePresentation } from '../config/service-presentation';
import ControlIcon from './ControlIcon.astro';
import ServicePhoto from './ServicePhoto.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = copy[locale];
const legacyAnchor = (id: string) =>
  Object.entries(legacyServiceIds).find(([, target]) => target === id)?.[0] ??
  id;
---

<BaseLayout
  locale={locale}
  page={routes.page('services')}
  title={t.servicesPageTitle}
  description={t.servicesPageDescription}
>
  <div class="page-intro" id="maintenance">
    <h1>{t.servicesPageHeading}</h1>
    <p>{t.servicesPageDescription}</p>
  </div>
  <ul class="service-directory section">
    {services.map((service, index) => {
      const wide = index === 0 || index === 5;
      return (
        <li
          id={legacyAnchor(service.id)}
          class="service-directory-card"
          data-wide={wide || undefined}
          style={`--service-tint:${servicePresentation(service.id).tint}`}
        >
          <a
            data-service-detail
            class="service-directory-link"
            href={routes.service(service.id).paths[locale]}
          >
            <div class="service-directory-photo">
              <ServicePhoto
                id={service.id}
                sizes={
                  wide
                    ? '(max-width: 580px) 90vw, (max-width: 950px) 45vw, 59vw'
                    : '(max-width: 580px) 90vw, (max-width: 950px) 45vw, 29vw'
                }
              />
            </div>
            <div class="service-directory-copy">
              <h2>{service.title[locale]}</h2>
              <p>{service.description[locale]}</p>
              <ControlIcon name="next" />
            </div>
          </a>
        </li>
      );
    })}
  </ul>
</BaseLayout>
