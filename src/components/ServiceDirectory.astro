---
import BaseLayout from '../layouts/BaseLayout.astro';
import { routes } from '../domain/routes';
import { copy, type Locale } from '../config/content';
import { legacyServiceIds, services } from '../config/services';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = copy[locale];
const legacyAnchor = (id: string) =>
  Object.entries(legacyServiceIds).find(([, target]) => target === id)?.[0] ??
  id;
---

<BaseLayout
  locale={locale}
  page={routes.page('services')}
  title={t.servicesPageTitle}
  description={t.servicesPageDescription}
>
  <div class="page-intro" id="maintenance">
    <h1>{t.servicesPageHeading}</h1>
    <p>{t.servicesPageDescription}</p>
  </div>
  <ul class="service-directory section">
    {services.map((service) => (
      <li id={legacyAnchor(service.id)} class="service-directory-card">
        <h2>
          <a href={routes.service(service.id).paths[locale]}>
            {service.licenceTitle[locale]}
          </a>
        </h2>
        <p>{service.description[locale]}</p>
        <a
          data-service-detail
          class="service-link"
          href={routes.service(service.id).paths[locale]}
          aria-label={`${t.serviceExplore}: ${service.title[locale]}`}
        >
          {t.serviceExplore}
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>
