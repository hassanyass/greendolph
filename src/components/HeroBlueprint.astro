---
import { copy, type Locale } from '../config/content';
import '../styles/blueprint.css';
const { locale } = Astro.props as { locale: Locale };
const t = copy[locale].blueprint;
// Every surface uses this footprint so the house and its plan share their openings.
const house = { width: 368, depth: 234, height: 198, x: 286, y: 289 };
const projection = { x: 0.88, y: 0.42 };
// Invert the isometric projection into a centered overhead plan, with a small camera zoom.
const planScale = 1.3;
const planX = 330 - (house.width * planScale) / 2;
const planY = 285 - (house.depth * planScale) / 2;
const planA = planScale / (2 * projection.x);
const planC = planScale / (2 * projection.y);
const planView = `matrix(${planA}, ${-planA}, ${planC}, ${planC}, ${planX - planA * house.x - planC * house.y}, ${planY + planA * house.x - planC * house.y})`;
const roofY = house.y - house.height;
const frontX = house.x - house.depth * projection.x;
const frontY = roofY + house.depth * projection.y;
const cornerX = frontX + house.width * projection.x;
const cornerY = frontY + house.width * projection.y;
const frontWindows = [
  { x: 37, y: 50, width: 106, height: 67 },
  { x: 169, y: 68, width: 73, height: 67 },
];
const sideWindow = { x: 59, y: 47, width: 114, height: 67 };
const door = { x: 274, y: 100, width: 64, height: 98 };
const paintPasses = Array.from({ length: 6 }, (_, index) => ({
  x: index * 61,
  width: index === 5 ? 63 : 64,
  animation: `paint-${index + 1}`,
  reverse: index % 2 === 1,
}));
---

<div class="hero-blueprint" data-blueprint>
  <p class="blueprint-summary">{t.summary}</p>
  <svg viewBox="0 0 660 570" fill="none" focusable="false" aria-hidden="true">
    <defs>
      {[
        { id: 'front', width: house.width },
        { id: 'side', width: house.depth },
      ].map(({ id, width }) => (
        <>
          <clipPath id={`${id}-cleaning`}>
            <rect class="cleaning-mask" width={width} height={house.height} />
          </clipPath>
          <mask
            id={`${id}-window-wash`}
            maskUnits="userSpaceOnUse"
            x="0"
            y="0"
            width={width}
            height={house.height}
          >
            <rect width={width} height={house.height} fill="white" />
            <rect
              class="cleaning-mask"
              width={width}
              height={house.height}
              fill="black"
            />
          </mask>
        </>
      ))}
      <clipPath id="paint-front">
        {paintPasses.map(({ x, width, animation, reverse }) => (
          <rect
            class:list={['paint-strip', { 'paint-strip-reverse': reverse }]}
            x={x}
            width={width}
            height={house.height}
            style={`--paint-pass: ${animation}`}
          />
        ))}
      </clipPath>
      <clipPath id="paint-side">
        {[0, 1, 2].map((index) => (
          <rect
            class="paint-strip"
            x={index * 78}
            width="79"
            height={house.height}
            style={`--paint-pass: paint-${index * 2 + 1}`}
          />
        ))}
      </clipPath>
    </defs>
    <g class="blueprint-camera">
      <ellipse class="house-shadow" cx="346" cy="498" rx="227" ry="28" />
      <g
        class="blueprint-journey"
        style={`--plan-view: ${planView}; --house-height: ${house.height}px`}
      >
        <g
          class="house-floor-projection"
          transform={`matrix(${projection.x} ${projection.y} ${-projection.x} ${projection.y} ${house.x} ${house.y})`}
        >
          <path class="blueprint-plane" d="M0 0H368V234H0Z" />
          <path
            class="house-floor-tiles"
            d="M11 47h346M11 143h346M11 191h346M62 11v212M114 11v85m0 57v70M166 11v212M279 11v122m0 50v40M331 11v212"
          />
          <path
            class="blueprint-outline"
            d="M0 234V0H368V234H338M274 234H0M11 223V11H357V223H338M274 223H11"
          />
          <path
            class="blueprint-detail"
            d="M11 104h86m47 0h74M11 112h86m47 0h74m-47 0v47a47 47 0 0 0 47-47M227 118h48m42 0h40M227 126h48m42 0h40m-82 0v42a42 42 0 0 0 42-42M274 223v-64a64 64 0 0 1 64 64M-17 0v234m-7-234h14m-14 234h14M0 253h368m-368-7v14m368-14v14"
          />
          <path
            class="blueprint-partition"
            d="M218 11v212m9-212v212M11 104h86m47 0h74M227 118h48m42 0h40"
          />
          <!-- Window marks are derived from the actual facade openings. -->
          {frontWindows.map((window) => (
            <path
              class="plan-window"
              d={`M${window.x} 226h${window.width}m${-window.width} 5h${window.width}`}
            />
          ))}
          <path
            class="plan-window"
            d={`M360 ${house.depth - sideWindow.x - sideWindow.width}v${sideWindow.width}m5 ${-sideWindow.width}v${sideWindow.width}`}
          />
        </g>
        <g class="house-facade">
          <g
            class="house-front-projection"
            style={`--wall-x:${frontX}px;--wall-y:${frontY}px`}
          >
            <g class="house-wall-height">
              <path class="house-wall house-wall-front" d="M0 0H368V198H0Z" />
              <g class="house-wear">
                <path
                  class="house-stain"
                  d="M14 40q16-8 27 8l9 30-7 22 9 34-22-4-5-30-10-13ZM197 34q14-8 26 8l17 23-5 42-20-5-4-31-17-15Z"
                />
                <path class="house-scuffs" d="M15 175h48m132 8h39" />
              </g>
              <path
                class="house-clean-front"
                clip-path="url(#front-cleaning)"
                d="M0 0H368V198H0Z"
              />
              <path
                class="house-cracks"
                d="m110 8-7 25 15 15-12 22 8 25m4-47 20-3m-24 50-10 12m156-72 10 17-11 16 7 18"
              />
              <path
                class="house-finish house-finish-front"
                clip-path="url(#paint-front)"
                d="M0 0H368V198H0Z"
              />
              <g class="house-openings">
                {frontWindows.map((window) => (
                  <>
                    <rect class="house-window" {...window} />
                    <path
                      class="house-window-lines"
                      d={`M${window.x + window.width / 2} ${window.y}v${window.height}M${window.x} ${window.y + window.height / 2}h${window.width}`}
                    />
                  </>
                ))}
                <rect class="house-door" {...door} />
                <path class="house-handle" d="M325 150h-8" />
              </g>
              <path
                class="house-window-grime"
                mask="url(#front-window-wash)"
                d="m49 65 34 25m-27 0 22 19m102-24 28 19"
              />
              <g class="house-paint-roller">
                <g class="roller-tool">
                  <path class="roller-arm" d="M48 0H63V-26H13V-48" />
                  <path class="roller-grip" d="M13-43v-29" />
                  <rect
                    class="roller-head"
                    x="-60"
                    y="-10"
                    width="120"
                    height="20"
                    rx="7"
                  />
                  <path class="roller-highlight" d="M-48-4H45" />
                </g>
              </g>
              <path class="house-wall-outline" d="M0 0H368V198H0Z" />
            </g>
          </g>
          <g
            class="house-side-projection"
            style={`--wall-x:${cornerX}px;--wall-y:${cornerY}px`}
          >
            <g class="house-wall-height">
              <path class="house-wall house-wall-side" d="M0 0H234V198H0Z" />
              <g class="house-wear">
                <path
                  class="house-stain"
                  d="M37 39q17-12 31 0l9 30-6 27 4 29-24 7-5-39-12-12Zm143-4q14-6 25 3l-3 41 7 17-13 40-22 8 7-37-7-22Z"
                />
                <path class="house-scuffs" d="M55 182h34m42-9h46" />
              </g>
              <path
                class="house-clean-side"
                clip-path="url(#side-cleaning)"
                d="M0 0H234V198H0Z"
              />
              <path
                class="house-cracks"
                d="m130 6-10 20 11 15-18 17 6 18m12-35 17-3"
              />
              <path
                class="house-finish house-finish-side"
                clip-path="url(#paint-side)"
                d="M0 0H234V198H0Z"
              />
              <g class="house-openings">
                <rect class="house-window" {...sideWindow} />
                <path class="house-window-lines" d="M116 47v67M59 80.5h114" />
              </g>
              <path
                class="house-window-grime"
                mask="url(#side-window-wash)"
                d="m73 65 27 20m35-24 23 21"
              />
              <path class="house-wall-outline" d="M0 0H234V198H0Z" />
            </g>
          </g>
        </g>
        <g class="blueprint-upper">
          <g
            transform={`translate(${house.x} ${roofY}) matrix(.88 .42 -.88 .42 0 0)`}
          >
            <path
              class="blueprint-plane blueprint-ceiling"
              d="M0 0H368V234H0Z"
            />
            <path
              class="blueprint-outline"
              d="M0 0H368V234H0ZM61 0v234M122 0v234M183 0v234M245 0v234M306 0v234M0 58h368M0 117h368M0 176h368"
            />
            <path
              class="blueprint-light"
              d="M129 65h47v45h-47ZM252 124h47v45h-47ZM68 183h47v44H68Z"
            />
          </g>
          <g
            class="roof-equipment"
            transform={`translate(${house.x} ${roofY - 35}) matrix(.88 .42 -.88 .42 0 0)`}
          >
            <path
              class="blueprint-duct"
              d="M27 75H290v84h42v30h-72v-84H154v65h-27v-65H27Z"
            />
            <path
              class="blueprint-air"
              d="M27 75H290v84h42v30h-72v-84H154v65h-27v-65H27ZM27 82h254v85h51M61 75v30m42-30v30m106-30v30m51 36h30M114 170h53v27h-53Zm9 5v17m9-17v17m9-17v17m9-17v17m9-17v17M332 151h26v46h-26Zm5 8h16m-16 8h16m-16 8h16m-16 8h16m-16 8h16"
            />
            <g class="roof-fault">
              <path class="roof-gap" d="M174 72h24v36h-24Z" />
              <path
                class="roof-broken-edge"
                d="m174 75-3 7 5 8-3 15m25-30 3 7-5 8 3 15"
              />
            </g>
            <g class="roof-repair-collar">
              <path
                class="roof-collar-body"
                d="M169 70h34v40h-34ZM174 70v40m24-40v40"
              />
              <circle class="roof-bolt" cx="174" cy="77" r="2.5" />
              <circle class="roof-bolt" cx="198" cy="103" r="2.5" />
            </g>
            <g class="roof-wrench">
              <path d="m174 77 28-28a11 11 0 0 1 15-12l-7 7 5 5 7-7a11 11 0 0 1-12 15l-28 28Z" />
            </g>
            <path
              class="blueprint-airflow"
              pathLength="100"
              d="M35 94H271v83h54"
            />
            <path
              class="blueprint-airflow"
              pathLength="100"
              d="M35 94H141v69"
            />
          </g>
        </g>
      </g>
    </g>
  </svg>
  <button
    type="button"
    class="blueprint-toggle"
    aria-label={t.pause}
    title={t.pause}
    data-blueprint-toggle
    data-pause-label={t.pause}
    data-play-label={t.play}
    hidden
  >
    <svg
      width="17"
      height="17"
      viewBox="0 0 24 24"
      fill="none"
      aria-hidden="true"
    >
      <path
        class="blueprint-icon-pause"
        d="M9 5v14m6-14v14"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      />
      <path
        class="blueprint-icon-play"
        d="m9 5 11 7-11 7Z"
        fill="currentColor"
      />
    </svg>
  </button>
</div>
