---
import { copy, type Locale } from '../config/content';
import '../styles/blueprint.css';
const { locale } = Astro.props as { locale: Locale };
const t = copy[locale].blueprint;
---

<div class="hero-blueprint" data-blueprint>
  <p class="blueprint-summary">{t.summary}</p>
  <svg viewBox="0 0 660 570" fill="none" focusable="false" aria-hidden="true">
    <defs>
      <clipPath id="house-facades">
        <path d="M80 190 404 345V543L80 388ZM404 345 610 246V444L404 543Z" />
      </clipPath>
      <clipPath id="house-renewal">
        <path class="renewal-mask" d="M-650 80H-10V570H-650Z" />
      </clipPath>
    </defs>
    <g class="blueprint-journey">
      <g class="journey-structure">
        <ellipse class="house-shadow" cx="346" cy="498" rx="227" ry="28" />
        <!-- The same floor, walls and ceiling remain connected through the loop. -->
        <!-- Projection lines connect the ceiling and floor plan. -->
        <path
          pathLength="100"
          class="blueprint-guides"
          d="M286 91V289M610 246V444M404 345V543M80 190V388
         M41 119h28m-14-14v28M595 57h28m-14-14v28M595 493h28m-14-14v28"
        />

        <path
          pathLength="100"
          class="blueprint-edge"
          d="M80 388 404 543 610 444v10L404 553 80 398Z"
        />
        <g transform="translate(286 289) matrix(.88 .42 -.88 .42 0 0)">
          <path class="blueprint-plane" d="M0 0H368V234H0Z" />
          <path
            class="house-floor-tiles"
            d="M11 47h346M11 143h346M11 191h346M62 11v212M114 11v85m0 57v70M166 11v212M279 11v122m0 50v40M331 11v212"
          />
          <path
            pathLength="100"
            class="blueprint-outline"
            d="M0 0H368V234H0ZM11 11H357V223H11ZM218 11v212M227 11v212"
          />
          <path
            pathLength="100"
            class="blueprint-detail"
            d="M11 96h86m47 0h74M11 104h86m47 0h74m-121 0v47a47 47 0 0 0 47-47
           M227 133h49m40 0h41m-130 8h49m40 0h41m-81 0v40a40 40 0 0 0 40-40
           M-17 0v234m-7-234h14m-14 234h14m10 19h368m-368-7v14m368-14v14"
          />
          <path
            pathLength="100"
            class="blueprint-partition"
            d="M14 96h82m50 0h72m9 37h48m42 0h39M218 13v208"
          />
        </g>

        <g class="house-facade">
          <path
            class="house-wall house-wall-front"
            d="M80 190 404 345V543L80 388Z"
          />
          <path
            class="house-wall house-wall-side"
            d="M404 345 610 246V444L404 543Z"
          />
          <g class="house-wear">
            <path
              class="house-stain"
              d="m93 243 38 18 6 94-29-13-5-32Zm168 74 34 17 8 77-35-15Zm181 86 39-19-5 80-27 13Zm107-103 29-14-7 92-29 14Z"
            />
            <path
              class="house-cracks"
              d="m176 243-7 27 15 22-18 21 9 31m9-52 25 4m-34 48-11 18m354-72-12 29 9 17-21 29 7 22m14-51 16 1"
            />
            <path
              class="house-scuffs"
              d="m94 366 46 22m112 53 39 19m175 27 32-16m39-20 45-22"
            />
          </g>
          <g clip-path="url(#house-renewal)">
            <path
              class="house-finish house-finish-front"
              d="M80 190 404 345V543L80 388Z"
            />
            <path
              class="house-finish house-finish-side"
              d="M404 345 610 246V444L404 543Z"
            />
          </g>
          <g class="house-openings">
            <path
              class="house-window"
              d="m113 257 93 44v67l-93-45Zm116 55 64 31v67l-64-31Zm227 55 100-48v67l-100 48Z"
            />
            <path
              class="house-window-lines"
              d="m159 279v67m-46-56 93 44m55-7v67m-32-49 64 31m213-33v67m-50-9 100-48"
            />
            <path class="house-door" d="m321 405 56 27v98l-56-27Z" />
            <path class="house-handle" d="m365 478-9-4" />
          </g>
          <g clip-path="url(#house-facades)">
            <path class="house-renewal-edge" d="M-7 130V565" />
          </g>
          <path
            class="house-wall-outline"
            pathLength="100"
            d="M80 190 404 345 610 246M80 190V388L404 543 610 444V246M404 345V543"
          />
          <path
            class="house-highlight"
            pathLength="100"
            d="M80 190 404 345 610 246V444L404 543 80 388V190"
          />
        </g>
        <g class="blueprint-upper">
          <g transform="translate(286 91) matrix(.88 .42 -.88 .42 0 0)">
            <path
              class="blueprint-plane blueprint-ceiling"
              d="M0 0H368V234H0Z"
            />
            <path
              pathLength="100"
              class="blueprint-outline"
              d="M0 0H368V234H0ZM61 0v234M122 0v234M183 0v234M245 0v234M306 0v234
           M0 58h368M0 117h368M0 176h368"
            />
            <path
              pathLength="100"
              class="blueprint-light"
              d="M129 65h47v45h-47ZM252 124h47v45h-47ZM68 183h47v44H68Z"
            />
          </g>

          <!-- Duct, branch and grilles sit above the suspended ceiling. -->
          <g transform="translate(286 65) matrix(.88 .42 -.88 .42 0 0)">
            <path
              pathLength="100"
              class="blueprint-duct-depth"
              d="M27 75H290v84h42v30h-72v-84H154v65h-27v-65H27Z"
            />
          </g>
          <g transform="translate(286 56) matrix(.88 .42 -.88 .42 0 0)">
            <path
              class="blueprint-duct"
              d="M27 75H290v84h42v30h-72v-84H154v65h-27v-65H27Z"
            />
            <path
              pathLength="100"
              class="blueprint-air"
              d="M27 75H290v84h42v30h-72v-84H154v65h-27v-65H27Z
           M27 82h254v85h51M61 75v30m42-30v30m106-30v30m51 36h30
           M114 170h53v27h-53Zm9 5v17m9-17v17m9-17v17m9-17v17m9-17v17
           M332 151h26v46h-26Zm5 8h16m-16 8h16m-16 8h16m-16 8h16m-16 8h16"
            />
            <path
              class="blueprint-airflow"
              pathLength="100"
              d="M35 94H271v83h54"
            />
            <path
              class="blueprint-airflow blueprint-airflow-branch"
              pathLength="100"
              d="M35 94H141v69"
            />
          </g>
        </g>
        <g class="blueprint-points">
          <circle cx="286" cy="91" r="3" />
          <circle cx="610" cy="246" r="3" />
          <circle cx="404" cy="345" r="3" />
          <circle cx="80" cy="190" r="3" />
        </g>
      </g>
    </g>
  </svg>
  <button
    type="button"
    class="blueprint-toggle"
    aria-label={t.pause}
    title={t.pause}
    data-blueprint-toggle
    data-pause-label={t.pause}
    data-play-label={t.play}
    hidden
  >
    <svg
      width="17"
      height="17"
      viewBox="0 0 24 24"
      fill="none"
      aria-hidden="true"
    >
      <path
        class="blueprint-icon-pause"
        d="M9 5v14m6-14v14"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      />
      <path
        class="blueprint-icon-play"
        d="m9 5 11 7-11 7Z"
        fill="currentColor"
      />
    </svg>
  </button>
</div>
