---
import { copy, type Locale } from '../config/content';
import '../styles/blueprint.css';
const { locale } = Astro.props as { locale: Locale };
const t = copy[locale].blueprint;
---

<div class="hero-blueprint" data-blueprint>
  <p class="blueprint-summary">{t.summary}</p>
  <svg viewBox="0 0 660 570" fill="none" focusable="false" aria-hidden="true">
    <g class="blueprint-journey">
      <!-- The repaired route stays in place as the surrounding building is drawn. -->
      <path class="journey-route" pathLength="100" d="M80 190L244 112" />
      <path
        class="journey-fault"
        pathLength="100"
        d="M244 112l7 12 7-17 6 13"
      />
      <path class="journey-bridge" pathLength="100" d="M244 112L274 98" />
      <path
        class="journey-continuation"
        pathLength="100"
        d="M274 98L286 91 610 246 404 345 80 190V388L404 543 610 444V246"
      />
      <g class="journey-leak">
        <path d="M256 138c-4 8-8 12-8 17a8 8 0 0 0 16 0c0-5-4-9-8-17Z" />
        <path d="M267 166c-3 6-6 9-6 13a6 6 0 0 0 12 0c0-4-3-7-6-13Z" />
      </g>
      <circle class="journey-repair" cx="259" cy="105" r="23" />
      <g class="journey-structure">
        <!-- Projection lines connect the ceiling and floor plan. -->
        <path
          pathLength="100"
          class="blueprint-guides"
          d="M286 91V289M610 246V444M404 345V543M80 190V388
         M41 119h28m-14-14v28M595 57h28m-14-14v28M595 493h28m-14-14v28"
        />

        <path
          pathLength="100"
          class="blueprint-edge"
          d="M80 388 404 543 610 444v10L404 553 80 398Z"
        />
        <g transform="translate(286 289) matrix(.88 .42 -.88 .42 0 0)">
          <path class="blueprint-plane" d="M0 0H368V234H0Z" />
          <path
            pathLength="100"
            class="blueprint-outline"
            d="M0 0H368V234H0ZM11 11H357V223H11ZM218 11v212M227 11v212"
          />
          <path
            pathLength="100"
            class="blueprint-detail"
            d="M11 96h86m47 0h74M11 104h86m47 0h74m-121 0v47a47 47 0 0 0 47-47
           M227 133h49m40 0h41m-130 8h49m40 0h41m-81 0v40a40 40 0 0 0 40-40
           M-17 0v234m-7-234h14m-14 234h14m10 19h368m-368-7v14m368-14v14"
          />
          <path
            pathLength="100"
            class="blueprint-partition"
            d="M14 96h82m50 0h72m9 37h48m42 0h39M218 13v208"
          />
        </g>

        <g transform="translate(286 91) matrix(.88 .42 -.88 .42 0 0)">
          <path class="blueprint-plane blueprint-ceiling" d="M0 0H368V234H0Z" />
          <path
            pathLength="100"
            class="blueprint-outline"
            d="M0 0H368V234H0ZM61 0v234M122 0v234M183 0v234M245 0v234M306 0v234
           M0 58h368M0 117h368M0 176h368"
          />
          <path
            pathLength="100"
            class="blueprint-light"
            d="M129 65h47v45h-47ZM252 124h47v45h-47ZM68 183h47v44H68Z"
          />
        </g>

        <!-- Duct, branch and grilles sit above the suspended ceiling. -->
        <g transform="translate(286 65) matrix(.88 .42 -.88 .42 0 0)">
          <path
            pathLength="100"
            class="blueprint-duct-depth"
            d="M27 75H290v84h42v30h-72v-84H154v65h-27v-65H27Z"
          />
        </g>
        <g transform="translate(286 56) matrix(.88 .42 -.88 .42 0 0)">
          <path
            class="blueprint-duct"
            d="M27 75H290v84h42v30h-72v-84H154v65h-27v-65H27Z"
          />
          <path
            pathLength="100"
            class="blueprint-air"
            d="M27 75H290v84h42v30h-72v-84H154v65h-27v-65H27Z
           M27 82h254v85h51M61 75v30m42-30v30m106-30v30m51 36h30
           M114 170h53v27h-53Zm9 5v17m9-17v17m9-17v17m9-17v17m9-17v17
           M332 151h26v46h-26Zm5 8h16m-16 8h16m-16 8h16m-16 8h16m-16 8h16"
          />
          <path
            class="blueprint-airflow"
            pathLength="100"
            d="M35 94H271v83h54"
          />
          <path
            class="blueprint-airflow blueprint-airflow-branch"
            pathLength="100"
            d="M35 94H141v69"
          />
        </g>

        <g class="blueprint-points">
          <circle cx="286" cy="91" r="3" />
          <circle cx="610" cy="246" r="3" />
          <circle cx="404" cy="345" r="3" />
          <circle cx="80" cy="190" r="3" />
        </g>
        <g class="blueprint-annotations">
          <path d="M27 141H103l44 31M633 103H548L404 188M24 462H104l76-35" />
          <circle cx="147" cy="172" r="2.5" />
          <circle cx="404" cy="188" r="2.5" />
          <circle cx="180" cy="427" r="2.5" />
          <text x="27" y="131">
            {t.ceiling}
          </text>
          <text x="633" y="93" text-anchor="end">
            {t.duct}
          </text>
          <text x="24" y="452">
            {t.plan}
          </text>
        </g>
      </g>
    </g>
  </svg>
  <button
    type="button"
    class="blueprint-toggle"
    aria-label={t.pause}
    title={t.pause}
    data-blueprint-toggle
    data-pause-label={t.pause}
    data-play-label={t.play}
    hidden
  >
    <svg
      width="17"
      height="17"
      viewBox="0 0 24 24"
      fill="none"
      aria-hidden="true"
    >
      <path
        class="blueprint-icon-pause"
        d="M9 5v14m6-14v14"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      />
      <path
        class="blueprint-icon-play"
        d="m9 5 11 7-11 7Z"
        fill="currentColor"
      />
    </svg>
  </button>
</div>
