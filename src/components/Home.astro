---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from './Hero.astro';
import Services from './Services.astro';
import { homeProcessPhoto } from '../config/home-photos';
import '../styles/home-process.css';
import QuoteForm from './QuoteForm.astro';
import { routes } from '../domain/routes';
import { media } from '../config/brand';
import BrandLogo from './BrandLogo.astro';
import { copy, type Locale } from '../config/content';
const { locale } = Astro.props as { locale: Locale };
const t = copy[locale];
---

<BaseLayout locale={locale}>
  <Hero locale={locale} />
  <Services locale={locale} />
  <section class="about section" id="about" aria-labelledby="about-title">
    <div class="about-image">
      <img
        src={media.interior}
        alt={t.aboutImageAlt}
        width="900"
        height="1050"
        loading="lazy"
      />
      <div class="image-caption">
        <BrandLogo locale={locale} variant="mark" />
        <span>{t.aboutNote}</span>
      </div>
    </div>
    <div class="about-copy">
      <p class="eyebrow">{t.aboutLabel}</p>
      <h2 id="about-title">{t.aboutTitle}</h2>
      <p>{t.aboutText}</p>
      <a class="text-link about-more" href={routes.path('about', locale)}>
        {t.aboutMore}
      </a>
      <div class="about-signature">
        <BrandLogo locale={locale} />
      </div>
    </div>
  </section>
  <section
    class="home-process"
    id="process"
    aria-labelledby="process-title"
    data-home-process
  >
    <div class="section home-process-layout">
      <div class="home-process-heading">
        <p class="eyebrow">{t.processLabel}</p>
        <h2 id="process-title">{t.homeProcessTitle}</h2>
      </div>
      <div class="home-process-photo">
        <img
          src={`${homeProcessPhoto}-480.webp`}
          srcset={`${homeProcessPhoto}-480.webp 480w, ${homeProcessPhoto}-800.webp 800w`}
          sizes="(max-width: 800px) 86vw, 40vw"
          width="800"
          height="1000"
          alt=""
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="home-process-details">
        <ol class="home-process-steps">
          {t.steps.map((step) => (
            <li>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))}
        </ol>
        <a class="button button-light" href={routes.enquiry(locale)}>
          {t.quote}
        </a>
      </div>
    </div>
  </section>
  <QuoteForm locale={locale} />
</BaseLayout>
