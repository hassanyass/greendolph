---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from './Hero.astro';
import Services from './Services.astro';
import QuoteForm from './QuoteForm.astro';
import { brand, media } from '../config/brand';
import { copy, type Locale } from '../config/content';
const { locale } = Astro.props as { locale: Locale };
const t = copy[locale];
---

<BaseLayout locale={locale}>
  <Hero locale={locale} />
  <Services locale={locale} />
  <section class="about section" id="about" aria-labelledby="about-title">
    <div class="about-image">
      <img
        src={media.interior}
        alt={t.aboutImageAlt}
        width="900"
        height="1050"
        loading="lazy"
      />
      <div class="image-caption">
        <img src={brand.mark} alt="" width="76" height="76" />
        <span>{t.aboutNote}</span>
      </div>
    </div>
    <div class="about-copy">
      <p class="eyebrow">{t.aboutLabel}</p>
      <h2 id="about-title">{t.aboutTitle}</h2>
      <p>{t.aboutText}</p>
      <details class="about-more">
        <summary class="text-link">
          {t.aboutMore}
          <span class="arrow" aria-hidden="true">
            ↗
          </span>
        </summary>
        <p>{t.aboutDetail}</p>
      </details>
      <div class="about-signature">
        <img src={brand.logo} alt={brand.name} width="280" height="60" />
      </div>
    </div>
  </section>
  <section class="process section" aria-labelledby="process-title">
    <p class="eyebrow">{t.processLabel}</p>
    <h2 id="process-title">{t.processTitle}</h2>
    <div class="steps">
      {t.steps.map((s, i) => (
        <article>
          <span class="step-index">0{i + 1}</span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </article>
      ))}
    </div>
  </section>
  <QuoteForm locale={locale} />
</BaseLayout>
