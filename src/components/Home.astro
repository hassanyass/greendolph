---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from './Hero.astro';
import Services from './Services.astro';
import { processIcons } from '../config/home-visuals';
import '../styles/home-process.css';
import QuoteForm from './QuoteForm.astro';
import { routes } from '../domain/routes';
import { brand, media } from '../config/brand';
import { copy, type Locale } from '../config/content';
const { locale } = Astro.props as { locale: Locale };
const t = copy[locale];
---

<BaseLayout locale={locale}>
  <Hero locale={locale} />
  <Services locale={locale} />
  <section class="about section" id="about" aria-labelledby="about-title">
    <div class="about-image">
      <img
        src={media.interior}
        alt={t.aboutImageAlt}
        width="900"
        height="1050"
        loading="lazy"
      />
      <div class="image-caption">
        <img
          src={brand.mark}
          alt=""
          width={brand.markSize.width}
          height={brand.markSize.height}
        />
        <span>{t.aboutNote}</span>
      </div>
    </div>
    <div class="about-copy">
      <p class="eyebrow">{t.aboutLabel}</p>
      <h2 id="about-title">{t.aboutTitle}</h2>
      <p>{t.aboutText}</p>
      <a class="text-link about-more" href={routes.path('about', locale)}>
        {t.aboutMore}
      </a>
      <div class="about-signature">
        <img
          src={brand.logo}
          alt={brand.name}
          width={brand.logoSize.width}
          height={brand.logoSize.height}
        />
      </div>
    </div>
  </section>
  <section
    class="home-process section"
    aria-labelledby="process-title"
    data-home-process
  >
    <div class="home-process-panel">
      <div class="home-process-heading">
        <div>
          <p class="eyebrow">{t.processLabel}</p>
          <h2 id="process-title">{t.homeProcessTitle}</h2>
        </div>
        <a class="text-link" href={routes.enquiry(locale)}>
          {t.quote}
        </a>
      </div>
      <ol class="home-process-steps">
        {t.steps.map((step, index) => (
          <li>
            <span class="process-symbol">
              <img
                src={`/icons/tabler/${processIcons[index]}.svg`}
                width="32"
                height="32"
                alt=""
                loading="lazy"
              />
            </span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>
  <QuoteForm locale={locale} />
</BaseLayout>
