---
import { company } from '../config/company';
import { contactCopy } from '../config/contact-copy';
import { routes, type Locale } from '../domain/routes';
import { services } from '../config/services';

interface Props {
  locale: Locale;
  placement: 'form' | 'footer' | 'shortcut' | 'service';
}
const { locale, placement } = Astro.props;
const t = contactCopy[locale];
const selectedService = services.find(
  (service) =>
    routes.service(service.id).paths[locale] === Astro.url.pathname ||
    service.id === Astro.url.searchParams.get('service'),
);
const message = selectedService
  ? t.whatsappServiceMessage.replace('{service}', selectedService.title[locale])
  : t.whatsappMessage;
const whatsapp = company.whatsappUrl
  ? `${company.whatsappUrl}?text=${encodeURIComponent(message)}`
  : null;
const displayPhone = (number: string) =>
  number.replace(/^(\+971)(5\d)(\d{3})(\d{4})$/, '$1 $2 $3 $4');
const phone = displayPhone(company.phone);
const socialLinks = [
  {
    icon: 'instagram',
    name: locale === 'ar' ? 'إنستغرام' : 'Instagram',
    url: company.social.instagram,
  },
  {
    icon: 'facebook',
    name: locale === 'ar' ? 'فيسبوك' : 'Facebook',
    url: company.social.facebook,
  },
  {
    icon: 'tiktok',
    name: locale === 'ar' ? 'تيك توك' : 'TikTok',
    url: company.social.tiktok,
  },
];
---

{placement === 'form' && (
  <div class="contact-actions">
    {whatsapp && (
      <a
        class="button contact-whatsapp"
        href={whatsapp}
        data-whatsapp-form
        data-message-default={t.whatsappMessage}
        data-message-service={t.whatsappServiceMessage}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="contact-channel-icon" aria-hidden="true"></span>
        {t.whatsapp}
      </a>
    )}
    <a class="text-link contact-form-link" href="#quote-form">
      {t.useForm}
    </a>
    <a
      class="text-link contact-phone"
      href={`tel:${company.phone}`}
      aria-label={`${t.call} ${phone}`}
    >
      <span>{t.call}</span>
      <bdi dir="ltr" class="contact-number">
        {phone}
      </bdi>
    </a>
    {company.email && (
      <a class="text-link" href={`mailto:${company.email}`}>
        <bdi dir="ltr">{company.email}</bdi>
      </a>
    )}
  </div>
)}
{placement === 'footer' && (
  <>
    <a
      class="footer-contact-line contact-phone"
      href={`tel:${company.phone}`}
      aria-label={`${t.call} ${phone}`}
    >
      <span>{t.call}</span>
      <bdi dir="ltr" class="contact-number">
        {phone}
      </bdi>
    </a>
    {whatsapp ? (
      <a
        class="footer-contact-line"
        href={whatsapp}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span
          class="footer-channel-icon"
          style="--channel-icon: url('/icons/whatsapp.svg')"
          aria-hidden="true"
        ></span>
        <span>{t.whatsappShort}</span>
        <bdi dir="ltr" class="contact-number">
          {displayPhone(company.whatsapp ?? '')}
        </bdi>
      </a>
    ) : (
      <span class="footer-contact-line footer-pending">
        <span
          class="footer-channel-icon"
          style="--channel-icon: url('/icons/whatsapp.svg')"
          aria-hidden="true"
        ></span>
        <span>{t.whatsappShort}</span> <small>{t.comingSoon}</small>
      </span>
    )}
    {company.email && (
      <a class="footer-contact-line" href={`mailto:${company.email}`}>
        {t.email}
      </a>
    )}
    <div class="footer-social">
      <p>
        {t.social}
        {socialLinks.every(({ url }) => !url) && (
          <small> · {t.comingSoon}</small>
        )}
      </p>
      <ul>
        {socialLinks.map(({ name, icon, url }) => (
          <li>
            {url ? (
              <a href={url} aria-label={name} title={name}>
                <span
                  class="footer-channel-icon"
                  style={`--channel-icon: url('/icons/${icon}.svg')`}
                  aria-hidden="true"
                ></span>
              </a>
            ) : (
              <span
                class="footer-social-placeholder"
                title={`${name} · ${t.comingSoon}`}
              >
                <span
                  class="footer-channel-icon"
                  style={`--channel-icon: url('/icons/${icon}.svg')`}
                  aria-hidden="true"
                ></span>
                <span class="visually-hidden">
                  {name} · {t.comingSoon}
                </span>
              </span>
            )}
          </li>
        ))}
      </ul>
    </div>
  </>
)}
{placement === 'service' && whatsapp && (
  <a
    class="button contact-whatsapp service-whatsapp"
    href={whatsapp}
    target="_blank"
    rel="noopener noreferrer"
  >
    <span class="contact-channel-icon" aria-hidden="true"></span>
    {t.whatsapp}
  </a>
)}
{placement === 'shortcut' && whatsapp && (
  <a
    class="whatsapp-shortcut"
    href={whatsapp}
    aria-label={t.whatsapp}
    target="_blank"
    rel="noopener noreferrer"
    data-whatsapp-shortcut
    hidden
  >
    <span class="contact-channel-icon" aria-hidden="true"></span>
    <span>{t.whatsappShort}</span>
  </a>
)}
