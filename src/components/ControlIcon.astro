---
interface Props {
  name: 'previous' | 'next' | 'down' | 'play' | 'pause';
  class?: string;
}
const { name, class: className } = Astro.props;
---

<svg
  class:list={['control-icon', className]}
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'previous' && <path d="m14 6-6 6 6 6" />}
  {name === 'next' && <path d="m10 6 6 6-6 6" />}
  {name === 'down' && <path d="m6 9 6 6 6-6" />}
  {name === 'play' && <path d="m9 5 10 7-10 7z" />}
  {name === 'pause' && (
    <>
      <path d="M9 5v14" />
      <path d="M15 5v14" />
    </>
  )}
</svg>
