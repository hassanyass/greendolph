---
interface Props {
  name: 'previous' | 'next' | 'down' | 'download';
  class?: string;
}
const { name, class: className } = Astro.props;
---

<svg
  class:list={['control-icon', className]}
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'previous' && <path d="m14 6-6 6 6 6" />}
  {name === 'next' && <path d="m10 6 6 6-6 6" />}
  {name === 'download' && <path d="M12 3v12m-5-5 5 5 5-5M5 15v5h14v-5" />}
  {name === 'down' && <path d="m6 9 6 6 6-6" />}
</svg>
