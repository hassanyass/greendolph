---
import { existsSync } from 'node:fs';
import { brand } from '../config/brand';
import { companyProfilePath, projects } from '../config/projects';
import { worksCopy } from '../config/works-copy';
import { routes, type Locale } from '../domain/routes';
import BaseLayout from '../layouts/BaseLayout.astro';
import ControlIcon from './ControlIcon.astro';
import ProjectImage from './ProjectImage.astro';
import '../styles/works.css';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = worksCopy[locale];
const title = locale === 'ar' ? 'أعمالنا' : 'Our Works';
const company = locale === 'ar' ? brand.arabicName : brand.name;
const hasProfile = existsSync(`public${companyProfilePath}`);
---

<BaseLayout
  locale={locale}
  page={routes.page('works')}
  title={`${title} | ${company}`}
  description={t.intro}
>
  <section class="work-index" aria-labelledby="works-title">
    <div class="work-index-intro">
      <div>
        <h1 id="works-title">{title}</h1>
        <p>{t.intro}</p>
      </div>
      <div class="work-profile">
        {hasProfile ? (
          <a class="button profile-download" href={companyProfilePath} download>
            <ControlIcon name="download" />
            {t.download}
          </a>
        ) : (
          <>
            <button
              class="button profile-download"
              type="button"
              disabled
              aria-describedby="profile-availability"
            >
              <ControlIcon name="download" />
              {t.download}
            </button>
            <p id="profile-availability">{t.profileSoon}</p>
          </>
        )}
      </div>
    </div>
    <div class="work-cards">
      {projects.map((project, index) => {
        const cover = project.photos[0];
        const featured = index === 0 && Boolean(cover);
        return (
          <article
            class:list={[
              'work-card',
              { 'work-feature': featured, 'work-text': !cover },
            ]}
            data-work-card
          >
            <a
              class="work-card-link"
              href={routes.project(project.id).paths[locale]}
            >
              {cover && (
                <div class="work-card-image">
                  <ProjectImage
                    photo={cover}
                    locale={locale}
                    decorative
                    priority={featured}
                    sizes={
                      featured
                        ? '(min-width: 900px) 58vw, 90vw'
                        : '(min-width: 700px) 43vw, 90vw'
                    }
                  />
                </div>
              )}
              <div class="work-card-body">
                <p class="work-location">{project.location[locale]}</p>
                <h2>{project.title[locale]}</h2>
                <p class="work-summary">{project.summary[locale]}</p>
                <span class="work-link">
                  {t.view}
                  <ControlIcon name="next" />
                </span>
              </div>
            </a>
          </article>
        );
      })}
    </div>
  </section>
  <script src="../scripts/works-motion.ts"></script>
</BaseLayout>
