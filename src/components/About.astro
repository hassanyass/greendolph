---
import BaseLayout from '../layouts/BaseLayout.astro';
import { aboutCopy } from '../config/about-copy';
import { media } from '../config/brand';
import BrandLogo from './BrandLogo.astro';
import { copy, type Locale } from '../config/content';
import { routes } from '../domain/routes';
const { locale } = Astro.props as { locale: Locale };
const t = copy[locale];
const a = aboutCopy[locale];
---

<BaseLayout
  locale={locale}
  page={routes.page('about')}
  title={t.aboutPageTitle}
  description={t.aboutPageDescription}
>
  <section class="about-hero" aria-labelledby="about-heading">
    <div class="section about-hero-layout">
      <div>
        <p class="eyebrow">{t.aboutLabel}</p>
        <h1 class="page-heading" id="about-heading">
          {t.aboutPageHeading}
        </h1>
        <p class="about-lead">{a.intro}</p>
      </div>
      <div class="about-identity">
        <BrandLogo locale={locale} variant="stacked" />
      </div>
    </div>
  </section>
  <section class="about section about-page" aria-labelledby="company-title">
    <div class="about-image">
      <img
        src={media.interior}
        alt={t.aboutImageAlt}
        width="900"
        height="1050"
        loading="lazy"
      />
    </div>
    <div class="about-copy">
      <h2 id="company-title">{a.company}</h2>
      {a.companyText.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
      <a class="text-link about-more" href={routes.path('services', locale)}>
        {t.viewServices}
      </a>
    </div>
  </section>
  <div class="about-direction">
    <div class="section about-direction-layout">
      <section aria-labelledby="vision-heading">
        <h2 id="vision-heading">{a.visionTitle}</h2>
        <p>{a.vision}</p>
      </section>
      <section aria-labelledby="mission-heading">
        <h2 id="mission-heading">{a.missionTitle}</h2>
        <p>{a.mission}</p>
      </section>
    </div>
  </div>
  <section class="section about-values" aria-labelledby="values-heading">
    <h2 id="values-heading">{a.valuesTitle}</h2>
    <dl>
      {a.values.map(({ title, text }) => (
        <div>
          <dt>{title}</dt>
          <dd>{text}</dd>
        </div>
      ))}
    </dl>
    <a class="button" href={routes.enquiry(locale)}>
      {t.quote}
    </a>
  </section>
</BaseLayout>
<style>
  .about-hero {
    background: var(--forest);
    color: var(--white);
    border-block-end: 4px solid var(--accent);
  }
  .about-hero-layout,
  .about-direction-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    align-items: center;
    gap: var(--section-column-gap);
  }
  .section {
    padding-block: var(--section-space);
  }
  .section h2 {
    font-size: var(--section-heading-size);
    text-wrap: balance;
  }
  .about-page {
    gap: var(--section-column-gap);
  }
  .about-copy h2 {
    margin-block-start: 0;
  }
  .about-copy > p:not(.eyebrow) {
    font-size: 1rem;
    line-height: 1.7;
    max-inline-size: 46ch;
    margin-block-start: 16px;
  }
  .about-hero .eyebrow {
    color: var(--accent);
  }
  .about-hero h1 {
    max-inline-size: 17ch;
    margin-block-start: 12px;
  }
  .about-lead {
    margin-block-start: 22px;
    max-inline-size: 52ch;
    line-height: 1.8;
  }
  .about-identity {
    display: grid;
    place-items: center;
    background: var(--paper);
    border-block-end: 4px solid var(--accent);
    border-radius: var(--panel-radius);
    padding: clamp(22px, 4vw, 54px);
    min-inline-size: 0;
  }
  .about-identity :global(img) {
    inline-size: clamp(145px, 17vw, 232px);
    block-size: auto;
  }
  .about-page {
    border: 0;
  }
  .about-page .about-image {
    block-size: clamp(280px, 35vw, 460px);
    border-radius: var(--panel-radius);
    overflow: hidden;
  }
  .about-direction {
    background: var(--mist);
  }
  .about-direction-layout {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
  }
  .about-direction section {
    border-block-start: 2px solid var(--green);
    padding-block-start: 20px;
  }
  .about-direction p,
  .about-values dd {
    color: var(--muted);
    line-height: 1.8;
    margin: 14px 0 0;
    max-inline-size: 53ch;
  }
  .about-values dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--panel-gap) var(--section-column-gap);
    margin-block: 30px;
  }
  .about-values dl div {
    border-block-start: 1px solid var(--line);
    padding-block-start: 18px;
  }
  .about-values dt {
    font-weight: 700;
    color: var(--green);
    font-size: 1.12rem;
  }
  @media (max-width: 680px) {
    .about-hero-layout,
    .about-direction-layout,
    .about-values dl {
      grid-template-columns: minmax(0, 1fr);
    }
    .about-identity {
      justify-self: start;
      min-inline-size: min(100%, 235px);
    }
  }
</style>
