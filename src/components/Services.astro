---
import { services, copy, type Locale } from '../config/content';
import { experience } from '../config/experience';
import { routes } from '../domain/routes';
import ControlIcon from './ControlIcon.astro';
const { locale } = Astro.props as { locale: Locale };
const t = copy[locale];
const { desktopVisible, tabletVisible, mobileVisible } = experience.carousel;
---

<section
  class="section services"
  id="services"
  aria-labelledby="services-title"
  data-carousel
  data-status={t.carouselStatus}
  style={`--cards-desktop:${desktopVisible};--cards-tablet:${tabletVisible};--cards-mobile:${mobileVisible}`}
>
  <p class="eyebrow">{t.servicesLabel}</p>
  <div class="services-heading">
    <div>
      <h2 id="services-title">{t.servicesTitle}</h2>
      <p>{t.servicesText}</p>
    </div>
    <a class="text-link" href={routes.path('services', locale)}>
      {t.viewServices}
    </a>
  </div>
  <div class="carousel-controls">
    <div class="carousel-buttons">
      <button
        type="button"
        class="carousel-control"
        data-previous
        aria-label={t.previousService}
        aria-controls="service-track"
        disabled
      >
        <ControlIcon name="previous" />
      </button>
      <button
        type="button"
        class="carousel-control"
        data-next
        aria-label={t.nextService}
        aria-controls="service-track"
      >
        <ControlIcon name="next" />
      </button>
    </div>
    <span class="carousel-status" aria-live="polite" aria-atomic="true"></span>
  </div>
  <div
    class="service-track"
    id="service-track"
    role="region"
    aria-label={t.carouselLabel}
    tabindex="0"
  >
    {services.map((service) => (
      <article class="service-card" id={`service-${service.id}`}>
        <a
          class="service-image"
          href={`${routes.path('services', locale)}#${service.id}`}
          aria-label={`${t.serviceExplore}: ${service.title[locale]}`}
        >
          <img
            src={service.image}
            alt={service.alt[locale]}
            width="720"
            height="650"
            loading="lazy"
          />
        </a>
        <div class="service-card-copy">
          <h3>
            <a href={`${routes.path('services', locale)}#${service.id}`}>
              {service.title[locale]}
            </a>
          </h3>
          <p>{service.description[locale]}</p>
          <a
            class="service-link"
            href={`${routes.path('services', locale)}#${service.id}`}
          >
            {t.serviceExplore}
            <ControlIcon name="next" />
          </a>
        </div>
      </article>
    ))}
  </div>
</section>
