---
import { services, copy, type Locale } from '../config/content';
const { locale } = Astro.props as { locale: Locale };
const t = copy[locale];
---

<section
  class="section services"
  id="services"
  aria-labelledby="services-title"
>
  <p class="eyebrow">{t.servicesLabel}</p>
  <div class="section-heading">
    <h2 id="services-title">{t.servicesTitle}</h2>
    <p>{t.servicesText}</p>
  </div>
  <div class="service-grid">
    {services.map((service, i) => (
      <article class="service-card" id={`service-${i}`}>
        <button
          class="service-image"
          data-dialog={`dialog-${service.id}`}
          aria-label={`${t.serviceExplore}: ${service.title[locale]}`}
        >
          <img
            src={service.image}
            alt={service.alt[locale]}
            width="720"
            height="800"
            loading="lazy"
          />
          <span class="service-number">0{i + 1}</span>
          <span class="service-image-arrow arrow" aria-hidden="true">
            ↗
          </span>
        </button>
        <div class="service-card-copy">
          <h3>{service.title[locale]}</h3>
          <p>{service.description[locale]}</p>
          <button class="text-link" data-dialog={`dialog-${service.id}`}>
            {t.serviceExplore}
            <span class="arrow" aria-hidden="true">
              ↗
            </span>
          </button>
        </div>
        <dialog
          id={`dialog-${service.id}`}
          class="service-dialog"
          aria-labelledby={`title-${service.id}`}
        >
          <button class="dialog-close" data-close aria-label={t.close}>
            ×
          </button>
          <img
            src={service.image}
            alt=""
            width="720"
            height="450"
            loading="lazy"
          />
          <div class="dialog-copy">
            <p class="eyebrow">{t.servicesLabel}</p>
            <h2 id={`title-${service.id}`}>{service.title[locale]}</h2>
            <p>{service.detail[locale]}</p>
            <a class="button" href="#contact" data-choose={service.id}>
              {t.dialogQuote}
              <span class="arrow" aria-hidden="true">
                ↗
              </span>
            </a>
          </div>
        </dialog>
      </article>
    ))}
  </div>
</section>
