---
import { services } from '../config/services';
import { copy, type Locale } from '../config/content';
import { experience } from '../config/experience';
import { routes } from '../domain/routes';
import { serviceIcons } from '../config/home-visuals';
import ControlIcon from './ControlIcon.astro';
const { locale } = Astro.props as { locale: Locale };
const t = copy[locale];
const { desktopVisible, tabletVisible, mobileVisible } = experience.carousel;
---

<section
  class="section services"
  id="services"
  aria-labelledby="services-title"
  data-carousel
  data-status={t.carouselStatus}
  style={`--cards-desktop:${desktopVisible};--cards-tablet:${tabletVisible};--cards-mobile:${mobileVisible}`}
>
  <div class="services-heading">
    <div>
      <h2 id="services-title">{t.servicesLabel}</h2>
    </div>
    <a class="text-link" href={routes.path('services', locale)}>
      {t.viewServices}
    </a>
  </div>
  <div class="carousel-controls">
    <div class="carousel-buttons">
      <button
        type="button"
        class="carousel-control"
        data-previous
        aria-label={t.previousService}
        aria-controls="service-track"
        disabled
      >
        <ControlIcon name="previous" />
      </button>
      <button
        type="button"
        class="carousel-control"
        data-next
        aria-label={t.nextService}
        aria-controls="service-track"
      >
        <ControlIcon name="next" />
      </button>
    </div>
    <span class="carousel-status" aria-live="polite" aria-atomic="true"></span>
  </div>
  <div
    class="service-track"
    id="service-track"
    role="region"
    aria-label={t.carouselLabel}
    tabindex="0"
  >
    {services.map((service) => (
      <article class="service-card" id={`service-${service.id}`}>
        <a
          class="service-card-link"
          href={routes.service(service.id).paths[locale]}
        >
          <img
            src={`/icons/tabler/${serviceIcons[service.id] ?? 'bolt'}.svg`}
            class="service-glyph"
            width="30"
            height="30"
            alt=""
          />
          <h3>{service.title[locale]}</h3>
          <span class="service-card-arrow">
            <ControlIcon name="next" />
          </span>
        </a>
      </article>
    ))}
  </div>
</section>
